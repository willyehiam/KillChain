{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killweb.game/research/schemas/military_organization_record.schema.json",
  "title": "Military Organization and Formation Record",
  "description": "A dated organization node. Display containment is intentionally separate from sourced command, support, mobilization, party, and statutory relationships.",
  "type": "object",
  "required": [
    "organization_id",
    "country_id",
    "controller_id",
    "name",
    "service",
    "component",
    "organization_kind",
    "echelon",
    "display_parent_organization_id",
    "relationship_record_ids",
    "headquarters_location_id",
    "personnel",
    "readiness",
    "mobilization",
    "roles",
    "temporal_validity",
    "provenance"
  ],
  "properties": {
    "organization_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "country_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "controller_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "native_name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "service": {
      "$ref": "common.schema.json#/$defs/service"
    },
    "component": {
      "$ref": "common.schema.json#/$defs/component"
    },
    "organization_kind": {
      "type": "string",
      "enum": [
        "political_authority",
        "ministry",
        "general_staff",
        "joint_command",
        "service_command",
        "strategic_arm",
        "operational_command",
        "formation",
        "unit",
        "base_command",
        "facility_unit",
        "reserve_pool",
        "mobilization_pool",
        "government_security_force",
        "other"
      ]
    },
    "echelon": {
      "type": "string",
      "enum": [
        "national_authority",
        "ministry",
        "general_staff",
        "theater_command",
        "functional_command",
        "service_command",
        "strategic_arm",
        "fleet",
        "army_group",
        "army",
        "corps",
        "division",
        "brigade",
        "regiment",
        "battalion",
        "company",
        "squadron",
        "wing",
        "group",
        "flotilla",
        "task_force",
        "base_command",
        "facility_unit",
        "detachment",
        "pool",
        "other"
      ]
    },
    "display_parent_organization_id": {
      "description": "Navigation containment only. This field never grants command, support, mobilization, ownership, or release authority.",
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "relationship_record_ids": {
      "description": "Typed external relationship records involving this organization. Empty only when no relationship has yet been accepted.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      }
    },
    "supported_organization_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      }
    },
    "headquarters_location_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "personnel": {
      "type": "object",
      "required": [
        "authorized",
        "assigned",
        "deployable"
      ],
      "properties": {
        "authorized": {
          "$ref": "common.schema.json#/$defs/quantityEstimate"
        },
        "assigned": {
          "$ref": "common.schema.json#/$defs/quantityEstimate"
        },
        "deployable": {
          "$ref": "common.schema.json#/$defs/quantityEstimate"
        }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "state",
        "basis"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unknown",
            "inactive",
            "forming",
            "training",
            "ready",
            "deployed",
            "degraded",
            "reconstituting",
            "demobilizing"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "direct_public_status",
            "official_aggregate",
            "independent_assessment",
            "scenario_assumption",
            "unknown"
          ]
        },
        "limiting_factors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "mobilization": {
      "type": "object",
      "required": [
        "status",
        "authority_id",
        "minimum_delay_hours"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "standing",
            "call_up_required",
            "mobilizing",
            "mobilized",
            "demobilizing",
            "unknown"
          ]
        },
        "authority_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_delay_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "equipment_pool_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inventory_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      }
    },
    "temporal_validity": {
      "$ref": "common.schema.json#/$defs/temporalValidity"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
