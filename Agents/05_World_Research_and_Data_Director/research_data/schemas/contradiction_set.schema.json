{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killweb.game/research/schemas/contradiction_set.schema.json",
  "title": "Research Contradiction Set",
  "type": "object",
  "required": [
    "contradiction_set_id",
    "question",
    "claim_ids",
    "status",
    "last_reviewed"
  ],
  "properties": {
    "contradiction_set_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "partially_reconciled",
        "resolved",
        "superseded"
      ]
    },
    "resolution": {
      "type": "string"
    },
    "simulation_rule": {
      "type": "string"
    },
    "last_reviewed": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "review_after": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
