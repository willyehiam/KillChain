{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killweb.game/research/schemas/common.schema.json",
  "title": "KillWeb Research Common Definitions",
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9_:-]*$"
    },
    "isoDateOrTimestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([Tt][0-9:.+-]+[Zz]?)?$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "confirmed",
        "high",
        "medium",
        "low",
        "disputed",
        "unknown"
      ]
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "ground",
        "maritime",
        "air",
        "space",
        "cyber",
        "information",
        "logistics",
        "joint"
      ]
    },
    "service": {
      "type": "string",
      "enum": [
        "joint",
        "army",
        "navy",
        "marine",
        "air_force",
        "space",
        "rocket_or_missile",
        "coast_guard",
        "gendarmerie",
        "cyber",
        "intelligence",
        "special_operations",
        "paramilitary",
        "other"
      ]
    },
    "component": {
      "type": "string",
      "enum": [
        "active",
        "reserve",
        "guard",
        "mobilization",
        "training",
        "civilian_agency",
        "other"
      ]
    },
    "accountingState": {
      "type": "string",
      "enum": [
        "active",
        "committed",
        "in_transit",
        "training",
        "maintenance",
        "reserve",
        "stored",
        "under_construction",
        "damaged",
        "destroyed",
        "exported",
        "retired",
        "captured",
        "unknown"
      ]
    },
    "quantityEstimate": {
      "type": "object",
      "required": [
        "kind",
        "unit"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exact",
            "range",
            "unknown"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "platform",
            "equipment_item",
            "launcher",
            "battery",
            "munition",
            "formation",
            "person",
            "capacity_unit"
          ]
        },
        "counting_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "exact"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "range"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "minimum",
              "maximum"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unknown"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "temporalValidity": {
      "type": "object",
      "required": [
        "valid_from",
        "as_of",
        "review_after"
      ],
      "properties": {
        "valid_from": {
          "$ref": "#/$defs/isoDateOrTimestamp"
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/isoDateOrTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of": {
          "$ref": "#/$defs/isoDateOrTimestamp"
        },
        "observed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/isoDateOrTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_after": {
          "$ref": "#/$defs/isoDateOrTimestamp"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "evidence_state",
        "confidence",
        "source_ids"
      ],
      "properties": {
        "evidence_state": {
          "$ref": "#/$defs/evidenceState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "contradiction_set_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidenceState": {
      "type": "string",
      "enum": [
        "observed",
        "official_claim",
        "independently_reported",
        "inferred",
        "estimated",
        "disputed",
        "designed",
        "synthetic",
        "unknown"
      ]
    },
    "locationStatus": {
      "type": "string",
      "enum": [
        "fixed_exact",
        "fixed_approximate",
        "reported_point",
        "reported_area",
        "route",
        "administrative_area",
        "synthetic_region",
        "withheld",
        "unknown"
      ]
    },
    "representationTier": {
      "type": "string",
      "enum": [
        "individual",
        "formation",
        "regional_network",
        "national_capability",
        "synthetic_node",
        "event_only",
        "background_only"
      ]
    },
    "forceMeasure": {
      "type": "string",
      "enum": [
        "unique_platform",
        "detected_platform",
        "peak_presence",
        "sortie",
        "formation",
        "unit",
        "personnel",
        "launcher",
        "munition",
        "event",
        "capacity"
      ]
    },
    "geoJsonGeometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {}
      },
      "additionalProperties": false
    },
    "geometryRecord": {
      "type": "object",
      "required": [
        "location_status",
        "crs"
      ],
      "properties": {
        "geometry": {
          "$ref": "#/$defs/geoJsonGeometry"
        },
        "location_status": {
          "$ref": "#/$defs/locationStatus"
        },
        "crs": {
          "type": "string",
          "const": "EPSG:4326"
        },
        "precision_m": {
          "type": "number",
          "minimum": 0
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "observed_at": {
          "$ref": "#/$defs/isoDateOrTimestamp"
        },
        "valid_to": {
          "$ref": "#/$defs/isoDateOrTimestamp"
        }
      },
      "additionalProperties": false
    }
  }
}
