{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killweb.game/research/schemas/bookmark.schema.json",
  "title": "KillWeb Historical Bookmark",
  "type": "object",
  "required": [
    "schema_version",
    "bookmark_id",
    "title",
    "status",
    "world_time",
    "approved_at",
    "temporal_policy",
    "design_rationale",
    "opening_conditions",
    "historical_trajectory_references"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bookmark_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "frozen",
        "deprecated"
      ]
    },
    "world_time": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "approved_at": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "temporal_policy": {
      "type": "object",
      "required": [
        "claim_validity_rule",
        "source_publication_rule",
        "post_start_event_rule",
        "player_knowledge_rule",
        "simulation_clock_rule"
      ],
      "properties": {
        "claim_validity_rule": {
          "type": "string",
          "const": "claim_must_describe_state_at_or_before_world_time"
        },
        "source_publication_rule": {
          "type": "string",
          "const": "later_sources_allowed_only_for_retrospective_pre_start_state"
        },
        "post_start_event_rule": {
          "type": "string",
          "const": "reference_trajectory_only_never_precommitted"
        },
        "player_knowledge_rule": {
          "type": "string",
          "const": "faction_beliefs_derive_from_pre_start_information_and_gameplay_observation"
        },
        "simulation_clock_rule": {
          "type": "string",
          "const": "real_time_with_pause_from_world_time"
        }
      },
      "additionalProperties": false
    },
    "design_rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "opening_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "condition_id",
          "region",
          "summary",
          "evidence_state",
          "confidence",
          "source_ids"
        ],
        "properties": {
          "condition_id": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_state": {
            "$ref": "common.schema.json#/$defs/evidenceState"
          },
          "confidence": {
            "$ref": "common.schema.json#/$defs/confidence"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/stableId"
            }
          },
          "research_status": {
            "type": "string",
            "enum": [
              "shell",
              "collecting",
              "needs_review",
              "verified",
              "stale"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "historical_trajectory_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "occurred_after_start",
          "summary",
          "use",
          "source_ids"
        ],
        "properties": {
          "event_id": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "occurred_after_start": {
            "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "type": "string",
            "const": "reference_only_not_initial_state"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/stableId"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
