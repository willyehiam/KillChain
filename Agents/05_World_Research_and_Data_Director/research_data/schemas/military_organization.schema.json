{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killweb.game/research/schemas/military_organization.schema.json",
  "title": "Military Organization",
  "type": "object",
  "required": [
    "organization_id",
    "name",
    "country_code",
    "organization_type",
    "as_of",
    "source_ids"
  ],
  "properties": {
    "organization_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "native_name": {
      "type": "string"
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "organization_type": {
      "type": "string",
      "enum": [
        "ministry",
        "joint_command",
        "service",
        "theater_command",
        "operational_command",
        "formation",
        "unit",
        "reserve",
        "paramilitary",
        "coast_guard",
        "intelligence",
        "other"
      ]
    },
    "echelon": {
      "type": "string"
    },
    "parent_organization_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "subordinate_organization_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "headquarters_facility_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "personnel_estimate": {
      "type": "number",
      "minimum": 0
    },
    "as_of": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/confidence"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
