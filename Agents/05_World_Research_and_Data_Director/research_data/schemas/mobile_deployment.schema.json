{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killweb.game/research/schemas/mobile_deployment.schema.json",
  "title": "Dated Mobile Deployment Observation",
  "type": "object",
  "required": [
    "observation_id",
    "subject_ids",
    "observed_at",
    "location",
    "measure",
    "source_ids",
    "confidence"
  ],
  "properties": {
    "observation_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "observed_at": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "valid_to": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "location": {
      "$ref": "common.schema.json#/$defs/geometryRecord"
    },
    "activity": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "quantity_min": {
      "type": "number",
      "minimum": 0
    },
    "quantity_max": {
      "type": "number",
      "minimum": 0
    },
    "measure": {
      "$ref": "common.schema.json#/$defs/forceMeasure"
    },
    "unique_identity_supported": {
      "type": "boolean"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/confidence"
    },
    "current_location_claim": {
      "type": "boolean",
      "const": false,
      "description": "Historical observations must not be presented as a current location."
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
