{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killweb.game/research/schemas/industrial_site.schema.json",
  "title": "Industrial Site",
  "type": "object",
  "required": [
    "site_id",
    "name",
    "industry_type",
    "country_code",
    "location",
    "as_of",
    "source_ids"
  ],
  "properties": {
    "site_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "industry_type": {
      "type": "string",
      "enum": [
        "shipbuilding",
        "aircraft",
        "vehicle",
        "electronics",
        "semiconductor",
        "steel",
        "chemical",
        "energy_equipment",
        "space",
        "defense",
        "dual_use",
        "other"
      ]
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "operator_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "public_capacity": {
      "type": "number",
      "minimum": 0
    },
    "capacity_unit": {
      "type": "string"
    },
    "conversion_potential": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "location": {
      "$ref": "common.schema.json#/$defs/geometryRecord"
    },
    "representation_tier": {
      "$ref": "common.schema.json#/$defs/representationTier"
    },
    "as_of": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/confidence"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
