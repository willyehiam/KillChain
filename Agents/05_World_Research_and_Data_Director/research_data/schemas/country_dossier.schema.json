{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killweb.game/research/schemas/country_dossier.schema.json",
  "title": "KillWeb Country Dossier Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "country_id",
    "country_code",
    "name",
    "bookmark_id",
    "as_of",
    "depth_tier",
    "coverage_status",
    "roster_basis",
    "coverage",
    "dataset_paths",
    "completeness",
    "source_ids",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "country_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "bookmark_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "as_of": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "depth_tier": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "shell",
        "collecting",
        "needs_review",
        "verified",
        "stale",
        "deprecated"
      ]
    },
    "roster_basis": {
      "type": "string",
      "enum": [
        "top_80_2025_nominal_gdp",
        "mandatory_strategic_addition"
      ]
    },
    "gdp_rank": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 80
    },
    "gdp_2025_usd_billions": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "coverage": {
      "type": "object",
      "required": [
        "politics_and_institutions",
        "economy_trade_finance_resources",
        "military_organization_inventory",
        "fixed_facilities_basing",
        "strategic_industry_conversion",
        "energy_transport_communications_logistics",
        "geography_provinces_terrain",
        "crises_alliances_sanctions_deployments"
      ],
      "properties": {
        "politics_and_institutions": {
          "type": "object",
          "required": [
            "status",
            "record_count",
            "source_count",
            "open_question_count"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "shell",
                "collecting",
                "needs_review",
                "verified",
                "stale",
                "deprecated"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "source_count": {
              "type": "integer",
              "minimum": 0
            },
            "open_question_count": {
              "type": "integer",
              "minimum": 0
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "economy_trade_finance_resources": {
          "type": "object",
          "required": [
            "status",
