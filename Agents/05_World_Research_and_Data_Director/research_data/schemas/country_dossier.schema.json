      "required": [
        "political_actor_target",
        "political_actor_count",
        "province_layer_status",
        "force_ledger_status"
      ],
      "properties": {
        "political_actor_target": {
          "type": "integer",
          "minimum": 0
        },
        "political_actor_count": {
          "type": "integer",
          "minimum": 0
        },
        "province_layer_status": {
          "type": "string",
          "enum": [
            "absent",
            "shell",
            "collecting",
            "needs_review",
            "verified",
            "stale"
          ]
        },
        "force_ledger_status": {
          "type": "string",
          "enum": [
            "absent",
            "shell",
            "collecting",
            "needs_review",
            "reconciled",
            "stale"
          ]
        }
      },
      "additionalProperties": false
    },
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
