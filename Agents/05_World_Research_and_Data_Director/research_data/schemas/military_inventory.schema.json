{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killweb.game/research/schemas/military_inventory.schema.json",
  "title": "Military Inventory Record",
  "type": "object",
  "required": [
    "inventory_id",
    "holder_id",
    "item_class",
    "measure",
    "as_of",
    "source_ids",
    "confidence"
  ],
  "properties": {
    "inventory_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "holder_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "item_class": {
      "type": "string",
      "minLength": 1
    },
    "item_variant": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "quantity_min": {
      "type": "number",
      "minimum": 0
    },
    "quantity_max": {
      "type": "number",
      "minimum": 0
    },
    "measure": {
      "$ref": "common.schema.json#/$defs/forceMeasure"
    },
    "status_breakdown": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "unique_identity_supported": {
      "type": "boolean"
    },
    "as_of": {
      "$ref": "common.schema.json#/$defs/isoDateOrTimestamp"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/confidence"
    },
    "notes": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "quantity"
      ]
    },
    {
      "required": [
        "quantity_min",
        "quantity_max"
      ]
    }
  ],
  "additionalProperties": false
}
